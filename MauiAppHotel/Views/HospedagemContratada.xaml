<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.HospedagemContratada"
             Title="Resumo"
             BackgroundColor="{StaticResource Gray100}">

    <VerticalStackLayout VerticalOptions="Center" Padding="20" Spacing="15">

        <Label Text="Resumo da Hospedagem"
               FontFamily="Kalam"
               FontSize="40"
               TextColor="{StaticResource Primary}" />

        <Frame Padding="15">
            <VerticalStackLayout Spacing="10">
                <Label Text="Suíte" FontSize="Subtitle" TextColor="{StaticResource Primary}" />
                <Label x:Name="lbl_quarto" />
                <Label Text="Hóspedes" FontSize="Subtitle" TextColor="{StaticResource Primary}" />
                <Label x:Name="lbl_hospedes" />
                <Label Text="Período" FontSize="Subtitle" TextColor="{StaticResource Primary}" />
                <Label x:Name="lbl_periodo" />
                <Label Text="Valor Total" FontSize="Subtitle" TextColor="{StaticResource Primary}" />
                <Label x:Name="lbl_total" FontSize="Title" />
            </VerticalStackLayout>
        </Frame>

        <Button Text="Voltar" Clicked="OnVoltarClicked" />
    </VerticalStackLayout>
</ContentPage>
