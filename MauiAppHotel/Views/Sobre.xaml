<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.Sobre"
             Title="Sobre"
             BackgroundColor="{StaticResource Gray100}">

    <VerticalStackLayout VerticalOptions="Center" Padding="20" Spacing="15">

        <Label Text="Sobre"
               FontFamily="Kalam"
               FontSize="50"
               TextColor="{StaticResource Primary}" />

        <Frame Padding="15">
            <VerticalStackLayout Spacing="10">
                <Label Text="App Hotel" FontSize="Subtitle" TextColor="{StaticResource Primary}" />
                <Label Text="Aplicativo de cálculo de diária de hospedagem." />
                <Label Text="Desenvolvedor: Guilherme" />
                <Label Text="Ano de desenvolvimento: 2026" />
            </VerticalStackLayout>
        </Frame>

        <Button Text="Voltar" Clicked="OnVoltarClicked" />
    </VerticalStackLayout>
</ContentPage>
